rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Users can read public profiles, but only edit their own.
    match /users/{userId} {
      allow read: if signedIn();
      // A new account must create its own profile at sign-up, before the email
      // is verified. Everything else still requires isVerified(), and the
      // router keeps unverified users on /verify, so this is the one write an
      // unverified-but-authenticated user is allowed — their own profile doc.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.university is string
        && request.resource.data.fcmTokens is list
        // New accounts are always plain users; admin is granted out of band.
        && request.resource.data.role == 'user';
      allow update: if isSelf(userId)
        && unchanged('id')
        && unchanged('email')
        && unchanged('createdAt')
        && unchanged('role')
        // Rating is owned by the review system, not the user themselves.
        && unchanged('rating')
        && unchanged('ratingCount')
        && request.resource.data.fcmTokens is list;
      allow delete: if false;

      // Saved listings belong to the owning user only.
      match /favorites/{listingId} {
        allow read, write: if isSelf(userId);
      }
    }

    // Marketplace listings.
    match /listings/{listingId} {
      allow read: if signedIn();

      allow create: if isVerified()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 70
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 500
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 6
        && request.resource.data.status == 'active'
        && request.resource.data.favoriteCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerified() && (
        // Owners may edit their listing, but identity and creation time are immutable.
        (
          resource.data.sellerId == request.auth.uid
          && unchanged('sellerId')
          && unchanged('createdAt')
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 70
          && request.resource.data.description.size() >= 15
          && request.resource.data.description.size() <= 500
          && request.resource.data.price >= 0
          && request.resource.data.imageUrls.size() <= 6
          && (request.resource.data.status in ['active', 'reserved', 'sold', 'swapped'])
          && request.resource.data.updatedAt == request.time
        )
        // Any signed-in student may register a single view.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.viewCount + 1
        )
        // Favoriting adjusts the saved counter by exactly one, either way.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
          && (
            request.resource.data.favoriteCount == resource.data.favoriteCount + 1
            || request.resource.data.favoriteCount == resource.data.favoriteCount - 1
          )
        )
      );

      allow delete: if isVerified() && resource.data.sellerId == request.auth.uid;
    }

    // Buyer <-> seller conversations. Only participants may read or write.
    match /conversations/{conversationId} {
      allow read: if isVerified() && request.auth.uid in resource.data.participantIds;

      allow create: if isVerified()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadBy == [];

      allow update: if isVerified()
        && request.auth.uid in resource.data.participantIds
        && unchanged('participantIds')
        && unchanged('buyerId')
        && unchanged('sellerId')
        && unchanged('listingId')
        && unchanged('createdAt');

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isVerified()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isVerified()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // A message must carry text or a photo (or both).
          && (
            request.resource.data.text.size() > 0
            || request.resource.data.imageUrl is string
          )
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }

    // Swap proposals: readable by both parties, only the owner can accept/decline.
    match /swaps/{swapId} {
      allow read: if isVerified() && request.auth.uid in resource.data.participantIds;

      allow create: if isVerified()
        && request.resource.data.offererId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerified()
        && resource.data.status == 'pending'
        && unchanged('offererId')
        && unchanged('ownerId')
        && unchanged('listingId')
        && unchanged('participantIds')
        && unchanged('createdAt')
        && request.resource.data.updatedAt == request.time
        && (
          // The listing owner accepts or declines.
          (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.status in ['accepted', 'declined']
          )
          // The proposer may withdraw their own pending offer.
          || (
            request.auth.uid == resource.data.offererId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    // In-app notifications live under the recipient's own tree. Any verified
    // student may drop a notification for another (e.g. a new message or swap
    // offer) since there is no Cloud Function sender, but only the owner can
    // read, mark read, or clear them.
    match /notifications/{userId}/items/{itemId} {
      allow read: if isSelf(userId);
      allow create: if isVerified()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.type is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      // The owner may only flip the read flag.
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSelf(userId);
    }

    // Reports are write-only from clients; moderators read them in the console.
    match /reports/{reportId} {
      allow create: if isVerified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
